# Copy to .env and adjust as needed. docker-compose.yml reads these automatically.
# Never commit a real .env file with production secrets.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=Root
MYSQL_DATABASE=book_store
MYSQL_PORT=3306

# --- user-service ---
SERVER_PORT=8081
JWT_SECRET=VpJ6yXEOXy1cwbvTF3aVYEDgLFMuuBlAvfC3OxCNxAcvj9PK9EZ3l8JwiUn4bgjm8FOz+Ll+HkYEQ4y0S/OjiQ==
JWT_EXPIRATION_MILLIS=3600000

# Leave blank to let RsaKeyProvider auto-generate an ephemeral RSA key pair (dev only).
# Set both to base64 PKCS8 (private) / X509 (public) DER bytes for stable production keys.
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=
JWT_KEY_ID=user-service-key-1

